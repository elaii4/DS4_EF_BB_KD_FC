@page "/"
@using System.Linq
@implements IDisposable
@inject PeopleApiService ApiService
@inject IJSRuntime JS

<PageTitle>Gestión de Personas</PageTitle>

@if (isInitialLoading)
{
    <LoadingBoxes />
}

<div class="main-dashboard p-4 p-md-5 w-100">

    <!-- BARRA SUPERIOR -->
    <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-2 text-muted small" style="font-size: 0.88rem;">
            <span>DS4 Hub</span>
            <span>›</span>
            <span class="text-dark fw-semibold">Gestión de Personas</span>
        </div>

        <div class="d-flex align-items-center gap-3 ms-auto">

            <button type="button" class="btn-mcp-toggle shadow-sm"
                    @onclick="OpenMcpPanelAsync"
                    title="Abrir centro de control MCP">
                <span class="mcp-button-icon">✦</span>
                <span>MCP</span>
            </button>

            <button type="button"
                    class="btn btn-server-toggle shadow-sm d-flex align-items-center gap-2"
                    style="@(ApiService.CurrentServer == ServerTarget.Windows ? "background-color: #0078d7; color: white;" : "background-color: #e95420; color: white;")"
                    @onclick="HandleToggleServer"
                    disabled="@isLoading"
                    title="Clic para cambiar de servidor">
                <span>@(ApiService.CurrentServer == ServerTarget.Windows ? "Servidor Win" : "Servidor Lin")</span>
            </button>

            <button class="circle-btn" @onclick="LoadPeopleAsync" disabled="@isLoading" title="Recargar lista">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
            </button>
        </div>
    </header>

    <!-- TÍTULO Y BARRA DE ACCIÓN -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom border-light">
        <div>
            <h1 class="display-6 fw-bold tracking-tight text-dark mb-0" style="font-size: 1.85rem;">Directorio de Personas</h1>
        </div>

        <div class="flex-grow-1 mx-md-4 search-pill-wrapper" style="max-width: 680px;">
            <svg width="17" height="17" fill="none" stroke="#94a3b8" stroke-width="2.5" viewBox="0 0 24 24" class="ms-2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>

            <input type="text" class="search-pill-input"
                   placeholder="Buscar por nombre..."
                   @bind="searchTerm"
                   @bind:event="oninput"
                   @onkeyup="HandleSearchKeyUp" />

            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <button class="btn btn-sm btn-link text-muted p-0 me-2 text-decoration-none" @onclick="ClearSearch">✕</button>
            }
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-modern-pill d-flex align-items-center gap-2 shadow-xs"
                    @onclick="GeneratePdfReportAsync"
                    disabled="@(isGeneratingReport || isLoading)"
                    title="Generar y descargar reporte en PDF con PdfSharp">

                @if (isGeneratingReport)
                {
                    <span class="spinner-border spinner-border-sm text-dark"></span>
                    <span>Generando...</span>
                }
                else
                {
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                    <span>Reporte PDF</span>
                }
            </button>

            <button class="btn-modern-black" @onclick="OpenCreateModal">
                <span>+ Agregar Persona</span>
            </button>
        </div>
    </div>

    <!-- ALERTAS -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert @(isAlertError ? "alert-danger" : "alert-success") alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
            <span class="small fw-medium">@alertMessage</span>
            <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
        </div>
    }

    <!-- FILTROS Y VISTAS -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div class="d-flex align-items-center gap-2 overflow-auto py-1">
            <button class="btn-pill-tag @(activeFilter == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>
                Todos (@(peopleList?.Count ?? 0))
            </button>
            <button class="btn-pill-tag @(activeFilter == "young" ? "active" : "")" @onclick='() => SetFilter("young")'>
                Jóvenes (25)
            </button>
            <button class="btn-pill-tag @(activeFilter == "adult" ? "active" : "")" @onclick='() => SetFilter("adult")'>
                Adultos (25)
            </button>
            <button class="btn-pill-tag @(activeFilter == "senior" ? "active" : "")" @onclick='() => SetFilter("senior")'>
                Senior (50)
            </button>
        </div>

        <div class="view-toggle-group">
            <button type="button" class="view-toggle-btn @(isCardView ? "active" : "")"
                    @onclick="() => isCardView = true" title="Vista en Tarjetas">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7"></rect>
                    <rect x="14" y="3" width="7" height="7"></rect>
                    <rect x="14" y="14" width="7" height="7"></rect>
                    <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
                <span>Tarjetas</span>
            </button>

            <button type="button" class="view-toggle-btn @(!isCardView ? "active" : "")"
                    @onclick="() => isCardView = false" title="Vista en Lista">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="8" y1="6" x2="21" y2="6"></line>
                    <line x1="8" y1="12" x2="21" y2="12"></line>
                    <line x1="8" y1="18" x2="21" y2="18"></line>
                    <line x1="3" y1="6" x2="3.01" y2="6"></line>
                    <line x1="3" y1="12" x2="3.01" y2="12"></line>
                    <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
                <span>Lista</span>
            </button>
        </div>
    </div>

    <!-- REGISTROS -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-grow text-dark" role="status" style="width: 2.2rem; height: 2.2rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-muted small mt-3 mb-0">Consultando API de @ApiService.CurrentServer...</p>
        </div>
    }
    else if (FilteredPeople == null || FilteredPeople.Count == 0)
    {
        <div class="empty-state-card text-center p-5 rounded-4 border bg-light bg-opacity-50">
            <div class="fs-1 mb-2">📭</div>
            <h5 class="fw-bold text-dark">No hay personas en este filtro</h5>
            <p class="text-muted small mb-3">Este servidor no tiene registros actualmente o la búsqueda no arrojó coincidencias.</p>
            <button class="btn-modern-black btn-sm" @onclick="OpenCreateModal">
                Crear primer registro
            </button>
        </div>
    }
    else
    {
        @if (isCardView)
        {
            <div class="row g-3">
                @for (int i = 0; i < FilteredPeople.Count; i++)
                {
                    var person = FilteredPeople[i];
                    var pastelClass = GetPastelClass(i);

                    <div class="col-md-6 col-lg-4">
                        <div class="card-pastel @pastelClass h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="badge rounded-pill bg-white text-dark shadow-xs fw-bold px-2 py-1" style="font-size: 0.72rem;">
                                        #@person.Id
                                    </span>

                                    <div class="d-flex gap-1">
                                        <button class="circle-dots-btn" @onclick="() => OpenEditModal(person)" title="Editar registro">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
                                                <path d="m15 5 4 4"></path>
                                            </svg>
                                        </button>

                                        <button class="circle-dots-btn btn-delete-action" @onclick="() => RequestDelete(person)" title="Eliminar registro">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 6h18"></path>
                                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                                                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                                                <line x1="10" x2="10" y1="11" y2="17"></line>
                                                <line x1="14" x2="14" y1="11" y2="17"></line>
                                            </svg>
                                        </button>
                                    </div>
                                </div>

                                <h5 class="fw-bold text-dark mb-1">@person.Name</h5>
                                <div class="text-muted small mb-0">
                                    <span>@person.Age años</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-responsive rounded-4 border bg-white shadow-xs p-3">
                <table class="table table-hover align-middle mb-0">
                    <thead class="text-muted small text-uppercase">
                        <tr class="border-bottom">
                            <th scope="col" style="width: 90px; font-weight: 700;">ID</th>
                            <th scope="col" style="font-weight: 700;">Nombre Completo</th>
                            <th scope="col" style="font-weight: 700;">Edad</th>
                            <th scope="col" class="text-end" style="width: 140px; font-weight: 700;">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var person in FilteredPeople)
                        {
                            <tr>
                                <td class="fw-bold text-muted">
                                    <span class="badge rounded-pill bg-light text-dark border px-2 py-1" style="font-size: 0.75rem;">
                                        #@person.Id
                                    </span>
                                </td>

                                <td class="fw-semibold text-dark fs-6">@person.Name</td>

                                <td>
                                    <span class="text-muted small">@person.Age años</span>
                                </td>

                                <td class="text-end">
                                    <button class="circle-dots-btn me-1" @onclick="() => OpenEditModal(person)" title="Editar registro">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
                                            <path d="m15 5 4 4"></path>
                                        </svg>
                                    </button>

                                    <button class="circle-dots-btn btn-delete-action" @onclick="() => RequestDelete(person)" title="Eliminar registro">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M3 6h18"></path>
                                            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                                            <line x1="10" x2="10" y1="11" y2="17"></line>
                                            <line x1="14" x2="14" y1="11" y2="17"></line>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

</div>

<!-- MODAL DE CREACIÓN Y EDICIÓN -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.45); backdrop-filter: blur(5px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-float" style="border-radius: 28px; overflow: hidden;">
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <div>
                        <h4 class="modal-title fw-bold text-dark">
                            @(isEditing ? "Editar Persona" : "Nueva Persona")
                        </h4>
                        <p class="text-muted small mb-0">
                            Persistencia directa en la base de datos de <strong>@ApiService.CurrentServer</strong>.
                        </p>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger py-2 small rounded-3 mb-3 border-0">
                            @modalError
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary text-uppercase tracking-wider">Nombre Completo</label>
                        <input type="text" class="form-control form-control-lg rounded-3 fs-6"
                               placeholder="Ej: Laura Martínez" maxlength="100"
                               @bind="formName" autofocus />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary text-uppercase tracking-wider">Edad</label>
                        <input type="number" class="form-control form-control-lg rounded-3 fs-6"
                               min="0" max="120" @bind="formAge" />
                    </div>
                </div>

                <div class="modal-footer border-0 bg-light bg-opacity-50 px-4 py-3">
                    <button type="button" class="btn btn-modern-pill" @onclick="CloseModal" disabled="@isSaving">
                        Cancelar
                    </button>

                    <button type="button" class="btn-modern-black px-4" @onclick="HandleSaveAsync" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Registro</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL DE CONFIRMACIÓN DE ELIMINACIÓN -->
@if (personToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.45); backdrop-filter: blur(5px);">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content border-0 shadow-float" style="border-radius: 28px; overflow: hidden;">
                <div class="modal-header border-0 pb-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="modal-title fw-bold text-dark mb-0">Eliminar Persona</h4>
                        <p class="text-muted small mb-0">Base de datos: <strong>@ApiService.CurrentServer</strong></p>
                    </div>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>

                <div class="modal-body p-4 text-center">
                    <div class="delete-icon-wrapper mb-3 mx-auto">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 6h18"></path>
                            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                            <line x1="10" x2="10" y1="11" y2="17"></line>
                            <line x1="14" x2="14" y1="11" y2="17"></line>
                        </svg>
                    </div>

                    <p class="text-secondary mb-1">¿Estás seguro de que deseas eliminar permanentemente a</p>
                    <h5 class="fw-bold text-dark mb-2">@personToDelete.Name</h5>

                    <p class="text-danger small mt-2 mb-0" style="font-size: 0.78rem;">
                        Esta acción borrará el registro de la base de datos de manera definitiva.
                    </p>
                </div>

                <div class="modal-footer border-0 bg-light bg-opacity-50 px-4 py-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-modern-pill" @onclick="CancelDelete" disabled="@isDeleting">
                        Cancelar
                    </button>

                    <button type="button" class="btn btn-danger-pill px-4" @onclick="ConfirmDeleteAsync" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Eliminando...</span>
                        }
                        else
                        {
                            <span>Eliminar Registro</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- PANEL FLOTANTE MCP -->
@if (showMcpPanel)
{
    <div class="mcp-overlay" @onclick="CloseMcpPanel">
        <div class="mcp-panel" @onclick:stopPropagation="true">

            <!-- ENCABEZADO -->
            <div class="mcp-header">
                <div>
                    <span class="mcp-label">CENTRO DE CONTROL</span>
                    <h4>Conexión MCP</h4>
                    <p>Administración de servidores e inteligencia artificial</p>
                </div>

                <button class="mcp-close" @onclick="CloseMcpPanel" title="Cerrar panel">✕</button>
            </div>

            <!-- CONTROL DEL SERVIDOR -->
            <div class="mcp-server-box">
                <div class="mcp-server-title">
                    <div class="mcp-server-title-icon">⌘</div>
                    <div>
                        <h5>Control del servidor</h5>
                        <span>Administración del estado del servicio MCP</span>
                    </div>
                </div>

                <div class="mcp-server-actions">

                    <button class="mcp-start-btn"
                            @onclick="StartMcpServer"
                            title="Verificar y conectar al servidor MCP">
                        <span>▶</span> Comprobar
                    </button>

                    <div class="mcp-status">
                        <span class="mcp-status-dot @(usageSummary?.McpServerOnline == true ? "connected" : "disconnected")"></span>
                        <span>@(usageSummary?.McpServerOnline == true ? "Servidor Activo" : "Sin conexión")</span>
                    </div>

                    <div class="mcp-port">
                        <span>Puerto</span>
                        <strong>5145</strong>
                    </div>

                </div>

                @if (!string.IsNullOrEmpty(mcpServerFeedback))
                {
                    <div class="mcp-query-feedback">
                        <span class="mcp-feedback-icon">ⓘ</span>
                        @mcpServerFeedback
                    </div>
                }
            </div>

            <!-- CONSULTAS MCP -->
            <div class="mcp-query-section">
                <div class="mcp-section-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="mcp-heading-icon">✎</div>
                        <div>
                            <h5 class="mb-0">Consultas MCP</h5>
                            <span>Escribe una instrucción para el servidor</span>
                        </div>
                    </div>

                    <!-- SELECTOR DE MOTOR IA -->
                    <div class="d-flex align-items-center gap-1 bg-white p-1 rounded-3 border shadow-xs" style="font-size: 0.8rem;">
                        <span class="text-muted fw-bold px-1 small">Motor:</span>
                        <button type="button" 
                                class="btn btn-sm py-1 px-2 rounded-2 fw-semibold border-0 @(selectedProvider == "gemini" ? "bg-dark text-white" : "text-secondary")"
                                @onclick="@(() => SetProvider("gemini"))">
                            ✦ Gemini
                        </button>
                        <button type="button" 
                                class="btn btn-sm py-1 px-2 rounded-2 fw-semibold border-0 @(selectedProvider == "qwen" ? "bg-dark text-white" : "text-secondary")"
                                @onclick="@(() => SetProvider("qwen"))">
                            ⚡ Qwen 3.8
                        </button>
                        <button type="button" 
                                class="btn btn-sm py-1 px-2 rounded-2 fw-semibold border-0 @(selectedProvider == "gpt-oss" ? "bg-dark text-white" : "text-secondary")"
                                @onclick="@(() => SetProvider("gpt-oss"))">
                            🤖 GPT-OSS 120B
                        </button>
                    </div>
                </div>

                <textarea class="mcp-query-input mt-2"
                          @bind="mcpQuery"
                          placeholder="@("Escribe tu consulta aquí...\n\nEjemplo: Registra a Carlos Gómez con 29 años o consulta las personas registradas.")"
                          rows="4"></textarea>

                <div class="mcp-query-footer">
                    <span class="mcp-query-hint">
                        @if (isMcpProcessing)
                        {
                            <span class="mcp-hint-dot" style="background-color: #f59e0b;"></span>
                            <span>Procesando consulta con @GetSelectedProviderName()...</span>
                        }
                        else if (usageSummary?.McpServerOnline == true)
                        {
                            <span class="mcp-hint-dot" style="background-color: #10b981;"></span>
                            <span>Conectado a @GetSelectedProviderName() + Servidor MCP (@ApiService.CurrentServer)</span>
                        }
                        else
                        {
                            <span class="mcp-hint-dot" style="background-color: #ef4444;"></span>
                            <span>Servidor MCP desconectado o no disponible en @ApiService.CurrentServer</span>
                        }
                    </span>

                    <button class="mcp-send-btn"
                            @onclick="SendMcpQuery"
                            disabled="@(isMcpProcessing || string.IsNullOrWhiteSpace(mcpQuery))">
                        @if (isMcpProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Consultando...</span>
                        }
                        else
                        {
                            <span>Enviar consulta</span>
                            <span>➤</span>
                        }
                    </button>
                </div>

                @if (lastQueryResponse != null && lastQueryResponse.ToolsExecuted != null && lastQueryResponse.ToolsExecuted.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2 mt-2 align-items-center">
                        <span class="small fw-semibold text-muted">Herramientas MCP:</span>
                        @foreach (var tool in lastQueryResponse.ToolsExecuted)
                        {
                            <span class="badge rounded-pill bg-dark text-white px-2 py-1 shadow-xs" style="font-size: 0.72rem;">
                                🛠 @tool
                            </span>
                        }
                        <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1" style="font-size: 0.72rem;">
                            ⚡ @lastQueryResponse.TokensUsed tokens
                        </span>
                        @if (lastQueryResponse.DatabaseModified)
                        {
                            <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1" style="font-size: 0.72rem;">
                                ✓ BD Actualizada
                            </span>
                        }
                    </div>
                }

                @if (lastQueryResponse != null && !string.IsNullOrWhiteSpace(lastQueryResponse.Reply))
                {
                    <div class="mcp-query-feedback mt-3" style="background: rgba(241, 245, 249, 0.95); border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; font-size: 0.88rem; color: #1e293b; white-space: pre-wrap; line-height: 1.5;">
                        <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom border-secondary border-opacity-10">
                            <span class="mcp-ai-icon" style="font-size: 1rem; color: #6366f1;">✦</span>
                            <strong class="text-dark">Respuesta de @(lastQueryResponse.Provider?.ToUpperInvariant() ?? "IA") (@(lastQueryResponse.Model)):</strong>
                        </div>
                        @lastQueryResponse.Reply
                    </div>
                }
                else if (!string.IsNullOrEmpty(mcpQueryFeedback))
                {
                    <div class="mcp-query-feedback mt-3">
                        <span class="mcp-feedback-icon">ⓘ</span>
                        @mcpQueryFeedback
                    </div>
                }
            </div>

            <!-- MONITOR DE INTELIGENCIAS ARTIFICIALES -->
            <div class="mcp-section">
                <div class="mcp-section-heading">
                    <div class="mcp-heading-icon">◈</div>
                    <div>
                        <h5>Monitor de IAs</h5>
                        <span>Consumo de tokens por plataforma</span>
                    </div>
                    <span class="mcp-live-indicator" style="color: #10b981; font-weight: 700;">● EN VIVO</span>
                </div>

                <div class="mcp-ai-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px;">

                    @if (usageSummary != null && usageSummary.Providers != null && usageSummary.Providers.Count > 0)
                    {
                        @foreach (var prov in usageSummary.Providers)
                        {
                            <div class="mcp-ai-card">
                                <div class="mcp-ai-name">
                                    <span class="mcp-ai-icon @(prov.Provider == "gemini" ? "gemini-icon" : "")" style="@(prov.Provider != "gemini" ? "color: #f97316;" : "")">
                                        @(prov.Provider == "gemini" ? "✦" : (prov.Provider == "qwen" ? "⚡" : "🤖"))
                                    </span>
                                    <span>@prov.DisplayName</span>
                                    <span class="badge @(prov.IsConfigured ? "bg-success" : "bg-warning") text-white px-2 py-0" style="font-size: 0.68rem;">
                                        @(prov.IsConfigured ? "ACTIVO" : "SIN CLAVE")
                                    </span>
                                </div>

                                <div class="mcp-progress">
                                    <div style="width: @(Math.Clamp(prov.UsagePercentage, 0, 100))%;"></div>
                                </div>

                                <div class="mcp-token-info">
                                    <span>Usados: <strong>@prov.UsedTokens.ToString("N0")</strong></span>
                                    <span>Disponibles: <strong>@prov.AvailableTokens.ToString("N0")</strong></span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- GEMINI POR DEFECTO -->
                        <div class="mcp-ai-card">
                            <div class="mcp-ai-name">
                                <span class="mcp-ai-icon gemini-icon">✦</span>
                                <span>Google Gemini</span>
                                <span class="badge @(usageSummary?.IsConfigured == true ? "bg-success" : "bg-warning") text-white px-2 py-0" style="font-size: 0.68rem;">
                                    @(usageSummary?.IsConfigured == true ? "ACTIVO" : "SIN CLAVE")
                                </span>
                            </div>

                            <div class="mcp-progress">
                                <div style="width: @(Math.Clamp(usageSummary?.UsagePercentage ?? 0, 0, 100))%;"></div>
                            </div>

                            <div class="mcp-token-info">
                                <span>Usados: <strong>@(usageSummary?.UsedTokens.ToString("N0") ?? "0")</strong></span>
                                <span>Disponibles: <strong>@(usageSummary?.AvailableTokens.ToString("N0") ?? "100,000")</strong></span>
                            </div>
                        </div>

                        <!-- QWEN 3.8 -->
                        <div class="mcp-ai-card">
                            <div class="mcp-ai-name">
                                <span class="mcp-ai-icon" style="color: #f97316;">⚡</span>
                                <span>Qwen 3.8</span>
                                <span class="badge bg-success text-white px-2 py-0" style="font-size: 0.68rem;">ACTIVO</span>
                            </div>
                            <div class="mcp-progress">
                                <div style="width: 0%;"></div>
                            </div>
                            <div class="mcp-token-info">
                                <span>Usados: <strong>0</strong></span>
                                <span>Disponibles: <strong>200,000</strong></span>
                            </div>
                        </div>

                        <!-- GPT-OSS 120B -->
                        <div class="mcp-ai-card">
                            <div class="mcp-ai-name">
                                <span class="mcp-ai-icon" style="color: #6366f1;">🤖</span>
                                <span>GPT-OSS 120B</span>
                                <span class="badge bg-success text-white px-2 py-0" style="font-size: 0.68rem;">ACTIVO</span>
                            </div>
                            <div class="mcp-progress">
                                <div style="width: 0%;"></div>
                            </div>
                            <div class="mcp-token-info">
                                <span>Usados: <strong>0</strong></span>
                                <span>Disponibles: <strong>200,000</strong></span>
                            </div>
                        </div>
                    }

                    <!-- ESTADO DEL SERVIDOR MCP -->
                    <div class="mcp-ai-card">
                        <div class="mcp-ai-name">
                            <span class="mcp-ai-icon" style="color: #3b82f6;">⚙</span>
                            <span>Servidor MCP (Capa 4)</span>
                            <span class="badge @(usageSummary?.McpServerOnline == true ? "bg-success" : "bg-danger") text-white px-2 py-0" style="font-size: 0.68rem;">
                                @(usageSummary?.McpServerOnline == true ? "ONLINE" : "OFFLINE")
                            </span>
                        </div>

                        <div class="mcp-progress">
                            <div style="width: @(usageSummary?.McpServerOnline == true ? "100%" : "0%"); background-color: @(usageSummary?.McpServerOnline == true ? "#10b981" : "#ef4444");"></div>
                        </div>

                        <div class="mcp-token-info">
                            <span>Puerto: <strong>5145</strong></span>
                            <span>Protocolo: <strong>JSON-RPC 2.0</strong></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PIE DEL PANEL -->
            <div class="mcp-panel-footer">
                <span>DS4 Hub · Integración MCP</span>
                <span>Panel de administración</span>
            </div>

        </div>
    </div>
}

