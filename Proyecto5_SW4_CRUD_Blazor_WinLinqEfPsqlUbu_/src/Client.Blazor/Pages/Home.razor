@code {
    private List<Person>? peopleList;
    private bool isLoading = true;
    private string searchTerm = "";
    private string activeFilter = "all";
    private string? alertMessage;
    private bool isAlertError;
    private bool isCardView = true;
    private bool isInitialLoading = true;
    private bool isGeneratingReport;

    // Estado del panel MCP
    private bool showMcpPanel;
    private string selectedProvider = "gemini";
    private string mcpQuery = "";
    private string? mcpQueryFeedback;
    private string? mcpServerFeedback;
    private bool isMcpProcessing;
    private McpQueryResponseDto? lastQueryResponse;
    private McpUsageSummaryDto? usageSummary;

    // Estado del modal de crear y editar
    private bool showModal;
    private bool isEditing;
    private int currentEditingId;
    private string formName = "";
    private int formAge = 18;
    private string? modalError;
    private bool isSaving;

    // Estado del modal de eliminación
    private Person? personToDelete;
    private bool isDeleting;

    private List<Person>? FilteredPeople
    {
        get
        {
            if (peopleList == null) return null;

            return activeFilter switch
            {
                "young" => peopleList.Where(p => p.Age <= 25).ToList(),
                "adult" => peopleList.Where(p => p.Age > 25 && p.Age < 50).ToList(),
                "senior" => peopleList.Where(p => p.Age >= 50).ToList(),
                _ => peopleList
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ApiService.OnServerChanged += HandleExternalServerChange;

        var loadTask = LoadPeopleAsync();
        var timerTask = Task.Delay(1500);

        await Task.WhenAll(loadTask, timerTask);

        isInitialLoading = false;
    }

    private void HandleExternalServerChange()
    {
        InvokeAsync(async () =>
        {
            await LoadPeopleAsync();
            StateHasChanged();
        });
    }

    private void SetFilter(string filter)
    {
        activeFilter = filter;
    }

    private async Task HandleToggleServer()
    {
        ApiService.ToggleServer();

        alertMessage = $"Servidor conmutado a: {ApiService.CurrentServer}";
        isAlertError = false;

        await LoadPeopleAsync();
    }

    private async Task LoadPeopleAsync()
    {
        try
        {
            isLoading = true;
            modalError = null;

            peopleList = await ApiService.GetPeopleAsync(searchTerm);
        }
        catch (Exception ex)
        {
            alertMessage = $"Error de conexión con el servidor {ApiService.CurrentServer} ({ApiService.CurrentBaseUrl}): {ex.Message}";
            isAlertError = true;
            peopleList = new List<Person>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadPeopleAsync();
        }
    }

    private async Task ClearSearch()
    {
        searchTerm = "";
        await LoadPeopleAsync();
    }

    private void OpenCreateModal()
    {
        isEditing = false;
        currentEditingId = 0;
        formName = "";
        formAge = 18;
        modalError = null;
        showModal = true;
    }

    private void OpenEditModal(Person person)
    {
        isEditing = true;
        currentEditingId = person.Id;
        formName = person.Name;
        formAge = person.Age;
        modalError = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        modalError = null;
    }

    private async Task HandleSaveAsync()
    {
        if (string.IsNullOrWhiteSpace(formName))
        {
            modalError = "El nombre es obligatorio.";
            return;
        }

        if (formAge < 0 || formAge > 120)
        {
            modalError = "La edad debe estar entre 0 y 120 años.";
            return;
        }

        try
        {
            isSaving = true;
            modalError = null;

            if (isEditing)
            {
                var dto = new PersonUpdateDto
                {
                    Name = formName.Trim(),
                    Age = formAge
                };

                await ApiService.UpdateAsync(currentEditingId, dto);

                alertMessage = $"Registro ID {currentEditingId} actualizado con éxito en {ApiService.CurrentServer}.";
            }
            else
            {
                var dto = new PersonCreateDto
                {
                    Name = formName.Trim(),
                    Age = formAge
                };

                var created = await ApiService.CreateAsync(dto);

                alertMessage = $"Persona '{created.Name}' (ID: {created.Id}) creada exitosamente en {ApiService.CurrentServer}.";
            }

            isAlertError = false;

            CloseModal();
            await LoadPeopleAsync();
        }
        catch (Exception ex)
        {
            modalError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void RequestDelete(Person person)
    {
        personToDelete = person;
    }

    private void CancelDelete()
    {
        personToDelete = null;
        isDeleting = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (personToDelete == null) return;

        try
        {
            isDeleting = true;

            await ApiService.DeleteAsync(personToDelete.Id);

            alertMessage = $"Registro '{personToDelete.Name}' (ID: {personToDelete.Id}) eliminado correctamente de {ApiService.CurrentServer}.";
            isAlertError = false;

            personToDelete = null;

            await LoadPeopleAsync();
        }
        catch (Exception ex)
        {
            alertMessage = ex.Message;
            isAlertError = true;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task GeneratePdfReportAsync()
    {
        try
        {
            isGeneratingReport = true;

            var pdfBytes = await ApiService.DownloadReportPdfBytesAsync(searchTerm);
            var base64 = Convert.ToBase64String(pdfBytes);

            var fileName = $"Reporte_Personas_{ApiService.CurrentServer}_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";

            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);

            alertMessage = $"Reporte PDF generado exitosamente desde el servidor {ApiService.CurrentServer}.";
            isAlertError = false;
        }
        catch (Exception ex)
        {
            alertMessage = $"Error al generar el reporte PDF: {ex.Message}";
            isAlertError = true;
        }
        finally
        {
            isGeneratingReport = false;
        }
    }

    // Abre el panel MCP y refresca métricas
    private async Task OpenMcpPanelAsync()
    {
        showMcpPanel = true;
        await RefreshMcpUsageAsync();
    }

    private void SetProvider(string provider)
    {
        selectedProvider = provider;
    }

    private string GetSelectedProviderName()
    {
        return selectedProvider switch
        {
            "qwen" => "Qwen 3.8",
            "gpt-oss" => "GPT-OSS 120B",
            _ => "Google Gemini"
        };
    }

    private async Task RefreshMcpUsageAsync()
    {
        try
        {
            usageSummary = await ApiService.GetMcpUsageAsync(selectedProvider);
        }
        catch
        {
            // Omitir si el servidor activo aún no responde
        }
    }

    // Cierra el panel MCP
    private void CloseMcpPanel()
    {
        showMcpPanel = false;
    }

    // Comprueba el estado del servidor MCP
    private async Task StartMcpServer()
    {
        mcpServerFeedback = "Verificando conexión con el Servidor MCP en http://localhost:5145/health...";
        await RefreshMcpUsageAsync();
        if (usageSummary?.McpServerOnline == true)
        {
            mcpServerFeedback = "¡Servidor MCP (Capa 4) activo y listo! Escuchando en el puerto 5145 con protocolo JSON-RPC 2.0.";
        }
        else
        {
            mcpServerFeedback = "El servidor MCP (Capa 4) no responde en el puerto 5145. Ejecuta 'iniciar-servidor-mcp.bat' en Windows.";
        }
    }

    // Envía la consulta a la IA seleccionada + MCP Server
    private async Task SendMcpQuery()
    {
        if (string.IsNullOrWhiteSpace(mcpQuery) || isMcpProcessing)
            return;

        try
        {
            isMcpProcessing = true;
            mcpQueryFeedback = null;
            lastQueryResponse = null;

            var result = await ApiService.SendMcpQueryAsync(mcpQuery, selectedProvider);
            lastQueryResponse = result;

            if (!result.IsSuccess)
            {
                mcpQueryFeedback = result.Reply;
            }
            else
            {
                if (result.DatabaseModified)
                {
                    await LoadPeopleAsync();
                }
            }

            // Actualizar monitor de uso de tokens
            await RefreshMcpUsageAsync();
        }
        catch (Exception ex)
        {
            mcpQueryFeedback = $"Error inesperado al procesar la consulta: {ex.Message}";
        }
        finally
        {
            isMcpProcessing = false;
        }
    }

    private string GetPastelClass(int index)
    {
        string[] classes =
        {
            "card-pastel-purple",
            "card-pastel-yellow",
            "card-pastel-green",
            "card-pastel-blue",
            "card-pastel-coral"
        };

        return classes[index % classes.Length];
    }

    public void Dispose()
    {
        ApiService.OnServerChanged -= HandleExternalServerChange;
    }
}